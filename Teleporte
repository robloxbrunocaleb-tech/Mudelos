-- ==========================================
-- 🎯 MÓDULO DE TELEPORTE & VIEW | IMPERIAL HUB
-- ==========================================

return function(container)
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local LocalPlayer = Players.LocalPlayer
    local Workspace = game:GetService("Workspace")
    local Camera = Workspace.CurrentCamera

    -- ==========================================
    -- 🎮 ESTADO DO SISTEMA
    -- ==========================================
    local State = {
        Noclip = false,
        SpeedBoost = false,
        SuperJump = false,
        Fly = false,
        FlySpeed = 50,
        CurrentTarget = nil,
        Viewing = false,
    }

    -- ==========================================
    -- 🧱 NOCLIP
    -- ==========================================
    local function SetNoclip(active)
        State.Noclip = active
        if active then
            RunService.Stepped:Connect(function()
                if not State.Noclip then return end
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end)
        end
    end

    -- ==========================================
    -- 🏃 SPEED BOOST
    -- ==========================================
    local function SetSpeedBoost(active)
        State.SpeedBoost = active
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = active and 50 or 16
            end
        end)
    end

    -- ==========================================
    -- 🦘 SUPER JUMP
    -- ==========================================
    local function SetSuperJump(active)
        State.SuperJump = active
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.JumpPower = active and 100 or 50
            end
        end)
    end

    -- ==========================================
    -- 🕊️ FLY (suave + noclip embutido)
    -- ==========================================
    local BodyGyro, BodyVelocity = nil, nil

    local function StartFly()
        State.Fly = true
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                BodyGyro = Instance.new("BodyGyro")
                BodyGyro.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                BodyGyro.D = 100
                BodyGyro.P = 5000
                BodyGyro.CFrame = root.CFrame
                BodyGyro.Parent = root

                BodyVelocity = Instance.new("BodyVelocity")
                BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                BodyVelocity.Velocity = Vector3.zero
                BodyVelocity.Parent = root
            end
        end)
    end

    local function StopFly()
        State.Fly = false
        if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
        if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
        pcall(function()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.zero end
        end)
    end

    RunService.Heartbeat:Connect(function(delta)
        if not State.Fly then return end
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root or not BodyGyro or not BodyVelocity then return end

            -- Noclip durante o fly
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            local cam = Camera
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            local up = Vector3.new(0, 1, 0)

            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += up end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= up end

            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit * State.FlySpeed
            end

            BodyVelocity.Velocity = moveDir
            BodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + (moveDir.Magnitude > 0 and moveDir or cam.LookVector))
        end)
    end)

    -- ==========================================
    -- 📡 TELEPORTE PARA JOGADOR
    -- ==========================================
    local function TeleportToPlayer(player)
        if not player or player == LocalPlayer then return end
        pcall(function()
            local targetRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot and localRoot then
                localRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
            end
        end)
    end

    -- ==========================================
    -- 👁️ VIEW (câmera no jogador)
    -- ==========================================
    local function ToggleView(player)
        if State.Viewing and State.CurrentTarget == player then
            -- Parar view
            State.Viewing = false
            State.CurrentTarget = nil
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                    Camera.CameraSubject = LocalPlayer.Character.Humanoid
                end
            end)
        else
            State.Viewing = true
            State.CurrentTarget = player
            pcall(function()
                if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                    Camera.CameraSubject = player.Character.Humanoid
                end
            end)
        end
    end

    -- ==========================================
    -- 🎨 INTERFACE
    -- ==========================================
    -- Lista de jogadores com paginação
    local ITENS_POR_PAGINA = 8
    local paginaAtual = 1
    local jogadoresFiltrados = {}

    -- Área superior: controles gerais
    local ControlsFrame = Instance.new("Frame", container)
    ControlsFrame.Size = UDim2.new(1, -10, 0, 30)
    ControlsFrame.Position = UDim2.new(0, 5, 0, 5)
    ControlsFrame.BackgroundTransparency = 1
    ControlsFrame.Parent = container

    local function CreateToggleButton(parent, text, posX, callback)
        local btn = Instance.new("TextButton", parent)
        btn.Size = UDim2.new(0, 100, 0, 28)
        btn.Position = UDim2.new(posX, 0, 0, 0)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.Parent = parent
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        btn.MouseButton1Click:Connect(function()
            local enabled = not btn:GetAttribute("Enabled")
            btn:SetAttribute("Enabled", enabled)
            btn.BackgroundColor3 = enabled and Color3.fromRGB(60, 140, 255) or Color3.fromRGB(40, 40, 60)
            callback(enabled)
        end)
        return btn
    end

    CreateToggleButton(ControlsFrame, "NOCLIP", 0, function(active) SetNoclip(active) end)
    CreateToggleButton(ControlsFrame, "SPEED", 0.25, function(active) SetSpeedBoost(active) end)
    CreateToggleButton(ControlsFrame, "JUMP", 0.5, function(active) SetSuperJump(active) end)

    -- Fly (botão separado)
    local FlyBtn = Instance.new("TextButton", ControlsFrame)
    FlyBtn.Size = UDim2.new(0, 100, 0, 28)
    FlyBtn.Position = UDim2.new(0.75, 0, 0, 0)
    FlyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    FlyBtn.Text = "FLY"
    FlyBtn.TextColor3 = Color3.fromRGB(255,255,255)
    FlyBtn.Font = Enum.Font.GothamBold
    FlyBtn.TextSize = 11
    FlyBtn.Parent = ControlsFrame
    Instance.new("UICorner", FlyBtn).CornerRadius = UDim.new(0, 5)
    FlyBtn.MouseButton1Click:Connect(function()
        State.Fly = not State.Fly
        if State.Fly then
            FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 255)
            FlyBtn.Text = "FLY ON"
            StartFly()
        else
            FlyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            FlyBtn.Text = "FLY"
            StopFly()
        end
    end)

    -- Slider de velocidade do fly
    local FlySpeedLabel = Instance.new("TextLabel", container)
    FlySpeedLabel.Size = UDim2.new(0, 120, 0, 20)
    FlySpeedLabel.Position = UDim2.new(0, 5, 0, 40)
    FlySpeedLabel.BackgroundTransparency = 1
    FlySpeedLabel.Text = "Fly Speed: 50"
    FlySpeedLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
    FlySpeedLabel.Font = Enum.Font.GothamBold
    FlySpeedLabel.TextSize = 11
    FlySpeedLabel.Parent = container

    local FlySpeedBar = Instance.new("Frame", container)
    FlySpeedBar.Size = UDim2.new(0, 150, 0, 4)
    FlySpeedBar.Position = UDim2.new(0, 5, 0, 65)
    FlySpeedBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    FlySpeedBar.Parent = container
    Instance.new("UICorner", FlySpeedBar).CornerRadius = UDim.new(1, 0)

    local FlySpeedBall = Instance.new("TextButton", FlySpeedBar)
    FlySpeedBall.Size = UDim2.new(0, 14, 0, 14)
    FlySpeedBall.Position = UDim2.new(0.5, -7, 0.5, -7)
    FlySpeedBall.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    FlySpeedBall.Text = ""
    FlySpeedBall.Parent = FlySpeedBar
    Instance.new("UICorner", FlySpeedBall).CornerRadius = UDim.new(1, 0)

    local draggingFlySpeed = false
    FlySpeedBall.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingFlySpeed = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingFlySpeed and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local barPos = FlySpeedBar.AbsolutePosition
            local barSize = FlySpeedBar.AbsoluteSize
            local relativeX = math.clamp(input.Position.X - barPos.X, 0, barSize.X)
            local percentage = relativeX / barSize.X
            FlySpeedBall.Position = UDim2.new(percentage, -7, 0.5, -7)
            State.FlySpeed = math.floor(percentage * 200) + 1
            FlySpeedLabel.Text = "Fly Speed: " .. State.FlySpeed
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingFlySpeed = false
        end
    end)

    -- Lista de jogadores
    local ScrollPlayers = Instance.new("ScrollingFrame", container)
    ScrollPlayers.Size = UDim2.new(1, -10, 1, -80)
    ScrollPlayers.Position = UDim2.new(0, 5, 0, 80)
    ScrollPlayers.BackgroundTransparency = 1
    ScrollPlayers.ScrollBarThickness = 3
    ScrollPlayers.Parent = container
    local ListPlayers = Instance.new("UIListLayout", ScrollPlayers)
    ListPlayers.Padding = UDim.new(0, 4)

    local function AtualizarPagina()
        for _, child in ipairs(ScrollPlayers:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local inicio = (paginaAtual - 1) * ITENS_POR_PAGINA + 1
        local fim = math.min(inicio + ITENS_POR_PAGINA - 1, #jogadoresFiltrados)

        for i = inicio, fim do
            local player = jogadoresFiltrados[i]
            if player and player ~= LocalPlayer then
                local Item = Instance.new("Frame", ScrollPlayers)
                Item.Size = UDim2.new(1, -4, 0, 45)
                Item.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
                Item.Parent = ScrollPlayers
                Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 6)

                -- Foto de perfil (carregada assíncrona)
                local Thumb = Instance.new("ImageLabel", Item)
                Thumb.Size = UDim2.new(0, 35, 0, 35)
                Thumb.Position = UDim2.new(0, 5, 0.5, -17.5)
                Thumb.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
                Thumb.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
                Thumb.Parent = Item
                Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

                task.spawn(function()
                    pcall(function()
                        local suc, content = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                        if suc then Thumb.Image = content end
                    end)
                end)

                -- Nome
                local Label = Instance.new("TextLabel", Item)
                Label.Size = UDim2.new(1, -150, 1, 0)
                Label.Position = UDim2.new(0, 45, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = player.DisplayName .. " (@" .. player.Name .. ")"
                Label.TextColor3 = Color3.fromRGB(220, 225, 235)
                Label.Font = Enum.Font.GothamSemibold
                Label.TextSize = 11
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = Item

                -- Botão TP
                local TPBtn = Instance.new("TextButton", Item)
                TPBtn.Size = UDim2.new(0, 45, 0, 25)
                TPBtn.Position = UDim2.new(1, -100, 0.5, -12.5)
                TPBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 255)
                TPBtn.Text = "TP"
                TPBtn.TextColor3 = Color3.fromRGB(255,255,255)
                TPBtn.Font = Enum.Font.GothamBold
                TPBtn.TextSize = 10
                TPBtn.Parent = Item
                Instance.new("UICorner", TPBtn).CornerRadius = UDim.new(0, 4)
                TPBtn.MouseButton1Click:Connect(function()
                    TeleportToPlayer(player)
                end)

                -- Botão View
                local ViewBtn = Instance.new("TextButton", Item)
                ViewBtn.Size = UDim2.new(0, 45, 0, 25)
                ViewBtn.Position = UDim2.new(1, -50, 0.5, -12.5)
                ViewBtn.BackgroundColor3 = Color3.fromRGB(100, 80, 200)
                ViewBtn.Text = "VIEW"
                ViewBtn.TextColor3 = Color3.fromRGB(255,255,255)
                ViewBtn.Font = Enum.Font.GothamBold
                ViewBtn.TextSize = 9
                ViewBtn.Parent = Item
                Instance.new("UICorner", ViewBtn).CornerRadius = UDim.new(0, 4)
                ViewBtn.MouseButton1Click:Connect(function()
                    ToggleView(player)
                    ViewBtn.Text = (State.Viewing and State.CurrentTarget == player) and "STOP" or "VIEW"
                    ViewBtn.BackgroundColor3 = (State.Viewing and State.CurrentTarget == player) and Color3.fromRGB(200,50,50) or Color3.fromRGB(100,80,200)
                end)
            end
        end

        ScrollPlayers.CanvasSize = UDim2.new(0, 0, 0, math.max(1, #jogadoresFiltrados) * 49 + 10)
    end

    -- Paginação
    local PageInfo = Instance.new("TextLabel", container)
    PageInfo.Size = UDim2.new(0, 100, 0, 20)
    PageInfo.Position = UDim2.new(0, 5, 1, -30)
    PageInfo.BackgroundTransparency = 1
    PageInfo.Text = "1/1"
    PageInfo.TextColor3 = Color3.fromRGB(220, 225, 235)
    PageInfo.Font = Enum.Font.GothamBold
    PageInfo.TextSize = 12
    PageInfo.Parent = container

    local PrevBtn = Instance.new("TextButton", container)
    PrevBtn.Size = UDim2.new(0, 40, 0, 25)
    PrevBtn.Position = UDim2.new(0, 5, 1, -30)
    PrevBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    PrevBtn.Text = "◀"
    PrevBtn.TextColor3 = Color3.fromRGB(255,255,255)
    PrevBtn.Font = Enum.Font.GothamBold
    PrevBtn.TextSize = 14
    PrevBtn.Parent = container
    Instance.new("UICorner", PrevBtn).CornerRadius = UDim.new(0, 4)

    local NextBtn = Instance.new("TextButton", container)
    NextBtn.Size = UDim2.new(0, 40, 0, 25)
    NextBtn.Position = UDim2.new(1, -45, 1, -30)
    NextBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    NextBtn.Text = "▶"
    NextBtn.TextColor3 = Color3.fromRGB(255,255,255)
    NextBtn.Font = Enum.Font.GothamBold
    NextBtn.TextSize = 14
    NextBtn.Parent = container
    Instance.new("UICorner", NextBtn).CornerRadius = UDim.new(0, 4)

    PrevBtn.MouseButton1Click:Connect(function()
        if paginaAtual > 1 then
            paginaAtual -= 1
            AtualizarPagina()
            local totalPaginas = math.max(1, math.ceil(#jogadoresFiltrados / ITENS_POR_PAGINA))
            PageInfo.Text = paginaAtual .. "/" .. totalPaginas
        end
    end)
    NextBtn.MouseButton1Click:Connect(function()
        local totalPaginas = math.max(1, math.ceil(#jogadoresFiltrados / ITENS_POR_PAGINA))
        if paginaAtual < totalPaginas then
            paginaAtual += 1
            AtualizarPagina()
            PageInfo.Text = paginaAtual .. "/" .. totalPaginas
        end
    end)

    -- Atualizar lista de jogadores
    local function AtualizarLista()
        jogadoresFiltrados = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(jogadoresFiltrados, player)
            end
        end
        paginaAtual = 1
        AtualizarPagina()
        local totalPaginas = math.max(1, math.ceil(#jogadoresFiltrados / ITENS_POR_PAGINA))
        PageInfo.Text = "1/" .. totalPaginas
    end

    Players.PlayerAdded:Connect(AtualizarLista)
    Players.PlayerRemoving:Connect(AtualizarLista)

    AtualizarLista()

    -- Limpeza ao sair do módulo
    container.AncestryChanged:Connect(function(_, parent)
        if not parent then
            State.Noclip = false
            State.SpeedBoost = false
            State.SuperJump = false
            StopFly()
            if State.Viewing then ToggleView(nil) end
        end
    end)
end
