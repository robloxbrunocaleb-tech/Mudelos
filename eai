    PrevBtn.MouseButton1Click:Connect(function()
        if paginaAtual > 1 then
            paginaAtual -= 1
            AtualizarPagina()
            PageInfo.Text = paginaAtual .. "/" .. math.max(1, math.ceil(#emoteListaFiltrada / ITENS_POR_PAGINA))
        end
    end)
    NextBtn.MouseButton1Click:Connect(function()
        local totalPaginas = math.max(1, math.ceil(#emoteListaFiltrada / ITENS_POR_PAGINA))
        if paginaAtual < totalPaginas then
            paginaAtual += 1
            AtualizarPagina()
            PageInfo.Text = paginaAtual .. "/" .. totalPaginas
        end
    end)

    -- Função de filtro
    local function BuscarEmotes(texto)
        emoteListaFiltrada = {}
        if string.find(texto, "roblox.com") then
            local id = tonumber(string.match(texto, "%d+"))
            if id then
                table.insert(emoteListaFiltrada, {Name = "Custom Link", Id = id})
            end
        elseif tonumber(texto) then
            table.insert(emoteListaFiltrada, {Name = "ID " .. texto, Id = tonumber(texto)})
        else
            for _, emote in ipairs(BASE_EMOTES) do
                if texto == "" or string.find(string.lower(emote.Name), string.lower(texto)) then
                    table.insert(emoteListaFiltrada, emote)
                end
            end
        end
        paginaAtual = 1
        AtualizarPagina()
        local totalPaginas = math.max(1, math.ceil(#emoteListaFiltrada / ITENS_POR_PAGINA))
        PageInfo.Text = "1/" .. totalPaginas
    end

    SearchEmote:GetPropertyChangedSignal("Text"):Connect(function()
        BuscarEmotes(SearchEmote.Text)
    end)

    -- Auto-atualizar Weight em modos automáticos
    RunService.Heartbeat:Connect(function(delta)
        if State.WeightMode ~= "Manual" and State.CurrentTrack then
            local speed = State.WeightOscSpeed
            if State.WeightMode == "Up" then
                State.Weight = math.min(State.MaxWeight, State.Weight + delta * speed)
            elseif State.WeightMode == "Down" then
                State.Weight = math.max(State.MinWeight, State.Weight - delta * speed)
            elseif State.WeightMode == "Loop" then
                State.WeightPhase = State.WeightPhase + delta * speed
                State.Weight = State.MinWeight + ((State.MaxWeight - State.MinWeight) * (math.sin(State.WeightPhase) + 1) / 2)
            end
            WeightBall.Position = UDim2.new(State.Weight, -9, 0.5, -9)
            pcall(function() State.CurrentTrack:AdjustWeight(State.Weight) end)
        end
    end)

    -- Inicializar lista
    BuscarEmotes("")
end
