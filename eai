            -- Limitar posição de tempo
            if State.TimeStart > 0 and track.TimePosition < State.TimeStart then
                track.TimePosition = State.TimeStart
            end
            if State.TimeEnd > 0 and track.TimePosition > State.TimeEnd then
                if State.PlayMode == "PauseEnd" then
                    track:AdjustSpeed(0)
                elseif State.PlayMode == "ResetEnd" then
                    track.TimePosition = State.TimeStart or 0
                else
                    -- Normal ou Reverse: se passar do fim, volta ao início (se loop)
                    if track.Looped then
                        track.TimePosition = State.TimeStart or 0
                    else
                        track:Stop()
                    end
                end
            end
        end
    end)

