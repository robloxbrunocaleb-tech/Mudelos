            if child:IsA("Frame") then child:Destroy() end
        end

        local inicio = (paginaAtual - 1) * ITENS_POR_PAGINA + 1
        local fim = math.min(inicio + ITENS_POR_PAGINA - 1, #emoteListaFiltrada)

        local itens = 0
        for i = inicio, fim do
            local emote = emoteListaFiltrada[i]
            if emote then
                itens = itens + 1
                local Card = Instance.new("Frame", EmoteGrid)
                Card.Size = UDim2.new(1, 0, 1, 0)
                Card.BackgroundColor3 = Color3.fromRGB(22, 28, 38)
