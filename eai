    -- ==========================================
    -- ▶️ FUNÇÃO PARA TOCAR EMOTE
    -- ==========================================
    local function PlayEmote(id)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

        if State.CurrentTrack then
            pcall(function() State.CurrentTrack:Stop() end)
            State.CurrentTrack = nil
        end

        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(id)
        local success, track = pcall(function() return animator:LoadAnimation(anim) end)
        if success and track then
            State.CurrentTrack = track
            track.Priority = Enum.AnimationPriority.Action
            track.Looped = (State.PlayMode == "Normal") -- apenas loop no modo normal
            track:Play()
            track:AdjustWeight(State.Weight)
            track:AdjustSpeed(State.Freeze and 0 or State.Speed)

            -- Aplicar modo de reprodução
            if State.PlayMode == "Reverse" then
                track:AdjustSpeed(-math.abs(State.Speed))
            end
        end
    end

